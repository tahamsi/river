# Python
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/
.venv/

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local environment files (infrastructure/native.env.example is tracked)
.env
.env.*
*.env

# Editors and OS
.idea/
.vscode/
.DS_Store

# Data: released corpus and its documentation are tracked
data/*
!data/README.md
!data/pat_redaction_manifest.json
!data/considerations/
!data/grounded_human_frozen/
data/grounded_human_frozen/*
!data/grounded_human_frozen/*.json
!data/grounded_human_frozen/*.jsonl

# Native baselines: upstream checkouts and their environments are installed by
# scripts/serving/setup_native_baselines.sh; only the RIVER wrappers are tracked
external/*
!external/river_*.py

# Generated outputs, model caches and server logs
artifacts/
.cache/
/logs/
*.log
!results/**/logs/*.log
