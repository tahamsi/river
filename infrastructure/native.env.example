# Local open-weight inference only. This file contains no hosted-model keys.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Hugging Face is used only to obtain gated open weights/datasets.
HF_TOKEN=

# Local graph infrastructure. Change the password before starting Neo4j.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-before-use
NEO4J_DATABASE=neo4j

LETTA_BASE_URL=http://127.0.0.1:8283
GRAPHITI_TELEMETRY_ENABLED=false
